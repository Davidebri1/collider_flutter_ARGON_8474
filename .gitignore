# Made by Claude. This folder is the repository: only the app's own source is tracked.
# Collider.exe goes to GitHub as a release download (dev\publish.py).
/*
!/dev/
/dev/.venv-build/
!/lib/
!/tools/
!/web/
!/docs/
!/test/
!/assets/
/assets/**/live/
!/pubspec.yaml
!/pubspec.lock
!/analysis_options.yaml
!/.metadata
!/.gitignore
!/README_CLAUDE.md
__pycache__/
*.log
/dev/editor/node_modules/
/dev/editor/test_out/
/dev/editor/*.log
/dev/editor/src/pdf_worker_source.js
/dev/editor/src/symbols_font.js
/dev/probe_out/
/dev/*.log
/dev/build_log.txt
